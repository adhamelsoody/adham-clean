{
  "env": {
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false"
  },
  "permissions": {
    "deny": [
      "Read(./_backup_*/**)",
      "Read(./.firebase/**)",
      "Read(./node_modules/**)",
      "Read(./functions/node_modules/**)",
      "Read(./quran/pages/**)",
      "Read(./icons/**)",
      "Read(./*.ps1)",
      "Read(./*.zip)",
      "Read(./*.rar)",
      "Read(./*.log)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(node -e *)",
      "Bash(node --check *)",
      "Bash(wc *)",
      "Bash(ls *)"
    ]
  }
}
