rules_version = '2';

/* =========================================================================
   قواعد Firestore الإنتاجية — ذات القرآنية
   مبنيّة على الاستخدام الفعلي للكود، بمبدأ أقلّ صلاحية.
   -------------------------------------------------------------------------
   ⚠️  لا تنشر هذا الملف قبل تنفيذ الخطوتين ١ و ٢:

   ١) أنشئ حسابك في Firebase Console ← Authentication، ثم أنشئ يدوياً
      المستند  users/{uid}  بالحقول:  { role: "admin", active: true, name: "..." }
      بدون هذه الخطوة لن يوجد أي مدير، ولن تستطيع الدخول إلى لوحة الإدارة.

   ٢) أزل منطق منح admin التلقائي من:
         auth.js            (السطور ~98-105)
         admin/shell.js     (السطور ~369-376)
      كلاهما ينشئ users/{uid} بدور admin لأي حساب بلا ملف. القواعد أدناه
      تمنع ذلك على مستوى الخادم (إنشاء الملف الذاتي مقيَّد بالأدوار غير
      الإدارية)، فيبقى الكود يحاول ويفشل، والأنظف إزالته.

   للتراجع: firestore.rules.backup-open يحوي القواعد المفتوحة السابقة.
   ========================================================================= */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------- دوال مساعدة ---------------- */

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    /* حساب موقوف (active == false) يفقد كل الصلاحيات فوراً */
    function isActive() {
      return hasProfile() && profile().active != false;
    }

    function role() {
      return isActive() ? profile().role : "";
    }

    /* مديرُ النظام. و owner مقبولٌ معه: إن وُجد حسابٌ بهذا الدور فحذفُه
       من هنا يقفله خارج النظام نهائياً. يُحذف بسطرٍ واحد متى تأكّدتَ
       أنه لا حساب بدور owner. */
    function isAdmin()      { return role() in ["admin", "owner"]; }

    /* مديرُ المجمّع ومديرُ المسجد: هما ما كان اسمه «مشرف».
       و supervisor باقٍ هنا جسراً حتى تُرحَّل الحسابات القديمة — من غيره
       يُقفل كلُّ حسابٍ لم يُرحَّل بعد خارج النظام. يُحذف بعد الترحيل. */
    function isManager()    { return role() in ["complexManager", "mosqueManager", "supervisor"]; }

    /* الاسمُ القديم باقٍ لأن 6 مواضع أدناه تستعمله — ومعناه الآن: مدير منشأة */
    function isSupervisor() { return isManager(); }
    function isTeacher()    { return role() == "teacher"; }

    /* سقفُ ما يمنحه مديرُ المنشأة من أدوار: لا أحدَ يمنح دوراً أعلى من
       دوره، وإلّا فتح حساباً بصلاحيةٍ أوسع ودخل به. مطابقٌ لـ GRANTABLE
       في app.js — إن غيّرتَها هناك فغيّرها هنا. */
    /* ومديرُ المجمّع يمنح «مشرف» و«داعم»، ومديرُ المسجد «مشرف» (٤٤٢) — كما
       قرّرته الإدارة في GRANTABLE. والحدُّ باقٍ: داخل منشأته (targetScopeOk)
       ولا دورَ في مستواه أو فوقه. بخريطةٍ لا بشرطٍ متداخل: الشرطُ المتداخل
       في قواعد الإنشاء علّق المحاكي من قبل (٤٣٦). */
    function grantableRoles() {
      return {
        'complexManager': ['mosqueManager', 'supervisor', 'teacher', 'parent', 'student', 'donor'],
        'mosqueManager':  ['supervisor', 'teacher', 'parent', 'student']
      }.get(role(), ['teacher', 'parent', 'student']);
    }

    /* من يحقّ له الكتابة في البيانات التشغيلية */
    /* بنداءٍ واحدٍ لـ role() (٤٣٤): كان isAdmin() || isManager() يقرأ الملفّ
       ويقيّمه مرّتين. القواعدُ تحدّ عددَ ما يُقيَّم في الطلب الواحد، وتجاوزُه
       يُردّ رفضاً — وقد بلغته قاعدتا الخطط وتأشير المصحف في ٤٣٢. المعنى هو هو. */
    function canWrite() {
      return role() in ['admin', 'owner', 'complexManager', 'mosqueManager', 'supervisor'];
    }

    /* من يحقّ له القراءة: أي حساب فعّال بدور معروف */
    function canRead() {
      return isActive() && role() in ['admin', 'owner', 'complexManager',
        'mosqueManager', 'supervisor', 'teacher', 'parent', 'student'];
    }

    /* =====================================================================
       الداعم (٤٣٠) — قراءةٌ محصورةٌ فيما تعرضه لوحتاه وحدَهما
       ---------------------------------------------------------------------
       كان خارج canRead، فتُفتح لوحةُ الداعم ولوحةُ الشرف فارغتين. ولم
       يُضَف إلى canRead نفسِها: تلك تفتح المجموعاتِ التشغيليةَ كلَّها
       (الرواتبَ والرسائلَ والطلبات…). فيقرأ ما تقرؤه لوحتاه فقط: المنشآتُ
       والحلقاتُ والطلابُ والمعلّمون والتسميعُ والحضورُ والبرامجُ والمستويات
       والفترات. ولا كتابةَ له في شيء.
       ===================================================================== */
    function isDonor() { return role() == "donor"; }
    function donorColls() {
      return ['complexes', 'mosques', 'circles', 'students', 'teachers',
              'recitations', 'attendance', 'programs', 'levels', 'terms'];
    }
    function donorMay(coll) { return isDonor() && coll in donorColls(); }

    /* =====================================================================
       ما لا يقرؤه الدورُ أصلاً (٤٤٠)
       ---------------------------------------------------------------------
       canRead() تشترط الدورَ وحده، فكان الطالبُ يقرأ مسيّراتِ الرواتب
       وطلباتِ القبول بجوالاتها وصادرَ الرسائل — والتطبيقُ يُنزّلها كلَّها
       إلى جهازه ثمّ يُخفيها عند العرض. تُحجب هنا المجموعاتُ التي لا تقرؤها
       شاشةٌ من شاشات الدور (جُردت من app.js):
         • المعلّم:           paySheets · admissions
         • الطالب ووليّ الأمر: paySheets · admissions · msgOutbox · moveLog
                              · procLog · sysAlerts
       والتطبيقُ لا يطلبها لهذه الأدوار (loadAllData) فلا يظهر رفض.
       ===================================================================== */
    function hiddenFrom(coll) {
      let r = role();
      return (r in ['teacher', 'student', 'parent'] && coll in ['paySheets', 'admissions'])
          || (r in ['student', 'parent'] && coll in ['msgOutbox', 'moveLog', 'procLog', 'sysAlerts'])
          || (r in ['student', 'parent'] && coll in kidColls())
          /* و students تُقرأ لهما من كتلتها وحدها (سجلّاتُ أبنائهما بأعيانها): كانت
             هذه الكتلةُ العامّة تُجيزها لهما كاملةً — والقواعدُ تُجمع بـ OR (٤٤٥) */
          || (r in ['student', 'parent'] && coll == 'students')
          /* ومن يعمل في مسجد: سجلّاتُ مسجده وحدَها (٤٤٧) — إن كان له مسجدٌ في ملفّه */
          || (r in mqRoles() && coll in mqColls() && hasMosque())
          /* ومديرُ المجمّع: سجلّاتُ مجمّعه وحدَها (٤٥٢) — إن كان له مجمّعٌ في ملفّه */
          || (r == 'complexManager' && coll in mqColls() && hasComplex());
    }

    /* =====================================================================
       المعلّمُ ومديرُ المسجد والمشرف: سجلّاتُ مسجدهم وحدَها (٤٤٧)
       ---------------------------------------------------------------------
       كانوا يقرؤون الطلابَ والمعلّمين والخططَ والحضورَ والتسميعَ في كلّ
       المنشآت. صارت قراءتُهم في هذه المجموعات لِما يحمل mosqueId من
       مساجدهم (mosqueId · mosqueIds في ملفّهم).

       قبل الحصر أُكمل mosqueId في ٣٤٥ سجلّاً قديماً بإذن المالك (من حلقة
       السجلّ ثمّ طالبه ثمّ معلّمه، بلا تغيير قيمةٍ مكتوبة)، فلم يبقَ بلا
       منشأة إلّا حضورٌ واحدٌ ومعلّمٌ واحد. وجُرّبت شاشاتُ المعلّم ومدير
       المسجد في B1 بالبيانات كاملةً ثمّ بسجلّات مسجده: لا فرق، إلّا خطّةَ
       طالبٍ من مسجدٍ آخر كانت تظهر لمدير المسجد في صفحة الخطط — وهي تسرّبٌ
       أصلحه الحصرُ نفسُه.

       ومن لا مسجدَ في ملفّه (حسابٌ لم يُسنَد بعد) يبقى كما كان: لا يُقفَل
       عليه عملُه. والتطبيقُ يقرأ لهم بالاستعلام نفسه (where mosqueId ==).
       والمساجدُ والحلقاتُ والبرامجُ وما يُشارَك تبقى مقروءةً: النقلُ بين
       المساجد يحتاج حلقاتِ غيره.
       ===================================================================== */
    function mqRoles() { return ['teacher', 'mosqueManager', 'supervisor']; }
    function mqColls() {
      return ['students', 'teachers', 'plans', 'assignments', 'attendance', 'recitations',
              'mushafMarks', 'exams', 'delays', 'pointsLog', 'storeOrders'];
    }
    function myMosques() {
      return profile().get('mosqueIds', []).concat([profile().get('mosqueId', '')]);
    }
    function hasMosque() {
      return profile().get('mosqueId', '') != '' || profile().get('mosqueIds', []).size() > 0;
    }
    function mqOwn(coll) {
      return coll in mqColls() && role() in mqRoles() && hasMosque()
          && resource.data.mosqueId in myMosques();
    }

    /* =====================================================================
       مديرُ المجمّع: سجلّاتُ مجمّعه وحدَها (٤٥٢)
       ---------------------------------------------------------------------
       كان يقرأ الطلابَ والمعلّمين والخططَ والحضورَ والتسميعَ في المجمّعات
       كلِّها، والتطبيقُ يُنزّلها إلى جهازه ثمّ يُخفيها عند العرض (فحصُ مدير
       مجمّع «العثمان» على الإنتاج: ٣٨٨ حضوراً له منها ٩). صارت قراءتُه في
       هذه المجموعات لِما يحمل complexId من مجمّعاته (complexId · complexIds
       في ملفّه)، والتطبيقُ يقرأ له بالاستعلام نفسه (where complexId ==).
       ومن لا مجمّعَ في ملفّه يبقى كما كان.
       ===================================================================== */
    function myComplexes() {
      return profile().get('complexIds', []).concat([profile().get('complexId', '')]);
    }
    function hasComplex() {
      return profile().get('complexId', '') != '' || profile().get('complexIds', []).size() > 0;
    }
    function cxOwn(coll) {
      return coll in mqColls() && role() == 'complexManager' && hasComplex()
          && resource.data.complexId in myComplexes();
    }

    /* =====================================================================
       الطالبُ ووليُّ أمره: سجلّاتُ أبنائه وحدَها (٤٤٤)
       ---------------------------------------------------------------------
       كان كلٌّ منهما يقرأ واجباتِ الطلاب جميعاً وحضورَهم وتسميعَهم وخططَهم
       ونقاطَهم في كلّ المنشآت — والتطبيقُ يُنزّلها إلى جهازه. صارت قراءتُه
       في هذه المجموعات لِما يحمل studentId من أبنائه (studentId · studentIds
       في ملفّه)، وفي students لسجلّاتهم بأعيانها.

       قيس قبل الحصر على بيانات الإنتاج (قراءةً فقط): كلُّ سجلٍّ في هذه
       المجموعات يحمل studentId نصّاً — إلّا حضوراً واحداً رقماً — وكلُّ
       حسابات الطلاب وأولياء الأمور مربوطةٌ بمعرّفاتٍ في ملفّها. وجُرِّبت
       شاشاتُهما كلُّها في B1 بالبياناتِ كاملةً ثمّ بسجلّاتهم وحدها: لا فرق.
       والتطبيقُ يقرأ لهما بالاستعلام نفسِه (where studentId ==) فتقبله القاعدة.
       ===================================================================== */
    function kidColls() {
      return ['assignments', 'attendance', 'recitations', 'mushafMarks', 'plans',
              'pointsLog', 'exams', 'storeOrders', 'delays'];
    }
    function kidIds() {
      return profile().get('studentIds', []).concat(profile().get('kids', []))
                      .concat([profile().get('studentId', '')]);
    }
    function kidOwn(coll) {
      return coll in kidColls() && role() in ['student', 'parent']
          && resource.data.studentId in kidIds();
    }

    /* =====================================================================
       سجلُّ صاحب الحساب (٤٣٠)
       ---------------------------------------------------------------------
       الطالبُ ووليُّ أمره يحفظان البريدَ والصورة في سجلّ الطالب، والمعلّمُ
       صورتَه في سجلّه — والقاعدةُ العامّة تشترط canWrite فكان الحفظُ يُردّ.
       فيُعرف السجلُّ بصاحبه: معرّفُه في ملف الحساب، أو uid الحساب فيه.
       ===================================================================== */
    function ownsStudent(docId) {
      return (role() == "student" &&
                ((profile().get('studentId', '') != '' && string(profile().get('studentId', '')) == docId)
                 || resource.data.get('uid', '') == request.auth.uid))
          || (role() == "parent" &&
                (docId in profile().get('studentIds', [])
                 || docId in profile().get('kids', [])));
    }
    /* الطالبُ نفسُه أو وليُّ أمره — بمعرّف الطالب وحده، بلا سجلٍّ قائم */
    function ownsSid(sid) {
      return (role() == "student" && sv(profile(), 'studentId') != '' && sv(profile(), 'studentId') == sid)
          || (role() == "parent" && (sid in profile().get('studentIds', []) || sid in profile().get('kids', [])));
    }
    function ownsTeacher(docId) {
      return isTeacher() &&
        ((profile().get('teacherId', '') != '' && string(profile().get('teacherId', '')) == docId)
         || resource.data.get('uid', '') == request.auth.uid);
    }
    /* حلقةُ المعلّم: في circleIds ملفه، أو معلّمُها المسجَّلُ هو */
    function ownsCircle(docId) {
      return isTeacher() &&
        (docId in profile().get('circleIds', [])
         || (profile().get('teacherId', '') != ''
             && string(resource.data.get('teacherId', '')) == string(profile().get('teacherId', ''))));
    }

    /* المجموعات التشغيلية التي يقرأها loadAllData() ويكتبها app.js.
       users و settings و site_messages مستثناة عمداً ولكلٍّ قواعده أدناه. */
    function operational() {
      return [
        'complexes', 'mosques', 'teachers', 'circles', 'students',
        'programs', 'levels', 'supCats', 'terms', 'plans', 'delays',
        /* planRules: قواعدُ التعويض لكلّ خطة. كانت خارج القائمة وبلا قاعدةِ
           مطابقة، فتقع تحت المنع الشامل — يكتبها التطبيق ويردّها الخادم.
           سجلُّها بلا مسجدٍ ولا مجمّع فيمرّ scopeOk، والكتابةُ لمن يملك
           canWrite وحده. */
        'planRules',
        /* ثمانيةٌ يقرؤها التطبيق ولا قاعدةَ لها، فتقع تحت المنع الشامل
           وتظهر في الكونسول: Missing or insufficient permissions.
           كلُّها بياناتٌ تشغيليّة يكتبها من يملك canWrite ويقرؤها من
           يملك canRead — كسائر ما في القائمة، فلا توسيعَ في الصلاحية:
             assignments  الواجبات اليومية
             sysAlerts    تنبيهات النظام
             procLog      سجلّ الإجراءات
             pointsLog    سجلّ النقاط
             storeOrders  طلبات المتجر
             paySheets    مسيّرات الرواتب
             msgOutbox    صادر الرسائل
             admissions   طلبات القبول                                   */
        'assignments', 'sysAlerts', 'procLog', 'pointsLog',
        'storeOrders', 'paySheets', 'msgOutbox', 'admissions',
        'reviews', 'dutyTypes', 'workflow', 'notifications', 'recitations',
        /* site_messages أُخرجت من هنا (٤٣٢): القراءةُ العامّة canRead كانت
           تمنح كلَّ حساب فعّال قراءةَ رسائل غيره متجاوزةً شرطَ المستلِم في
           كتلتها أدناه — والقواعد تُجمع بـ OR. لها كتلتُها وحدها الآن. */
        'mushafMarks',
        'attendance', 'exams', 'rewards', 'examPaths', 'rewardRules',
        'questions', 'questionGroups', 'examSupervisors', 'examCommittees',
        'examRouting', 'certTemplates', 'moveLog', 'userRequests'
      ];
    }

    /* الأدوار المسموح للمستخدم أن ينشئ بها ملفه بنفسه.
       admin و supervisor غير مدرجين: لا يمنحهما إلا مديرٌ قائم. */
    function selfRoles() {
      return ['teacher', 'parent', 'student'];
    }

    /* الحقول التي يملك المستخدم تعديلها في ملفه الشخصي */
    function selfEditable() {
      return ['name', 'phone', 'nationality', 'gender', 'photo'];
    }

    /* حقولُ الارتباط: المسجدُ والمجمّعُ والحلقةُ والبرنامجُ والخطةُ
       والمستوى وصاحبُ السجلّ. «بياناتُ الارتباط لا تتغيّر تلقائياً» —
       والمعلّمُ لا يغيّرها أصلاً، إنما الإدارة بإجراءٍ صريح. */
    function linkFields() {
      return ['mosqueId', 'complexId', 'circleId', 'programId',
              'planId', 'levelId', 'studentId', 'teacherId'];
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /* «اليوم» بساعة الخادم (٤٣٢، صُحّح في ٤٣٣) — التاريخُ محفوظٌ نصّاً
       YYYY-MM-DD بتوقيت جهاز المعلّم، فيُقبل إن طابق تاريخَ الآن أو تاريخَ
       (الآن − ١٢ ساعة) أو (الآن + ١٤ ساعة) بتوقيت غرينتش: يومُ المعلّم الجاري
       في أيّ منطقةٍ زمنية، ولا يدخل فيه يومٌ مضى.
       صيغةُ ٤٣٢ (فهرسةُ قائمةٍ ومقارنةُ نصوصٍ بـ >=) أخفقت على المحاكي، فصارت
       مطابقةً بالمساواة وحشوَ الصفر بالشرط الثلاثيّ — وهو مستعملٌ في هذا
       الملفّ منذ البداية (perms). */
    function dayStr(t) {
      return string(t.year()) + '-' + (t.month() < 10 ? '0' : '') + string(t.month())
           + '-' + (t.day() < 10 ? '0' : '') + string(t.day());
    }
    function anyToday(s) {
      return s is string
        && (s == dayStr(request.time)
            || s == dayStr(timestamp.value(request.time.toMillis() - 43200000))
            || s == dayStr(timestamp.value(request.time.toMillis() + 50400000)));
    }

    /* ---------------- مصفوفة صلاحيات المعلم ---------------- */
    /* الافتراضات هنا مطابقة لـ PERM_DEFAULT في governance.js — إن غيّرتها
       هناك فغيّرها هنا، وإلا سمح المتصفح ومنع الخادم (أو العكس). */
    function perms() {
      return isActive() ? profile().get('perms', {}) : {};
    }

    function perm(key, byDefault) {
      return perms().get(key, byDefault) == true;
    }

    /* =====================================================================
       الصلاحيةُ بمفتاحيها (٤٣٢)
       ---------------------------------------------------------------------
       بطاقةُ المعلّم تحفظ مفاتيحَ TEACHER_PERMS في app.js (attEdit · recite
       · editMarks · editPlan …)، والقواعدُ كانت تقرأ مفاتيحَ governance.js
       وحدَها (attend_edit · recite_edit · mushaf_past · plan_edit). فمن
       أطفأت الإدارةُ صلاحيتَه في بطاقته بقي يكتب على الخادم.
       فيُقرأ مفتاحُ البطاقة أوّلاً إن ضُبط، ثمّ مفتاحُ الرقابة، ثمّ
       الافتراضيُّ العامّ من «إدارة الصلاحيات» (settings/teacherPerms)،
       ثمّ الافتراضيّ المكتوب هنا — كما يقرؤها teacherCan في المتصفّح.
       ===================================================================== */
    function tpPath() { return /databases/$(database)/documents/settings/teacherPerms; }
    function globalOff(alias) {
      return exists(tpPath())
        && get(tpPath()).data.get('teacherPerms', {}).get(alias, true) == false;
    }
    /* تقييمٌ كسول (٤٣٤): الافتراضيُّ العامّ لا يُقرأ إلّا حين لا تضبط البطاقةُ
       ولا الرقابةُ المفتاح — وكان يُقرأ في كلّ طلب. المعنى هو هو. */
    function permOf(key, alias, byDefault) {
      return permIn(perms(), key, alias, byDefault);
    }
    function permIn(p, key, alias, byDefault) {
      return p.get(alias, null) != null ? p.get(alias, null) == true
           : (p.get(key, null) != null ? p.get(key, null) == true
              : (byDefault && !globalOff(alias)));
    }

    /* معلّم يملك الصلاحية — أو إداريٌّ لا تلزمه */
    function teacherMay(key, byDefault) {
      return canWrite() || (isTeacher() && perm(key, byDefault));
    }
    function teacherMayAs(key, alias, byDefault) {
      return canWrite() || (isTeacher() && permOf(key, alias, byDefault));
    }


    /* ---------------- حصر النطاق عند الكتابة ---------------- */
    /* المدير العام (بلا نطاق محفوظ) بلا حدّ. ومن له نطاق لا يكتب إلا داخله.
       ⚠ هذا حصر كتابة لا قراءة: loadAllData يقرأ المجموعات كاملةً، فتقييد
         القراءة بالنطاق يُفشل الاستعلام كلّه. تقييد القراءة يحتاج تحويل
         القراءات إلى استعلامات مُصفّاة أولاً — انظر ملف النشر. */
    function scopeIds() {
      return profile().get('mosqueIds', [])
        .concat(profile().get('complexIds', []))
        .concat([profile().get('mosqueId', ''), profile().get('complexId', '')]);
    }

    /* حساب بلا أي ارتباط بمنشأة — المدير العام وحده يبقى بلا حدّ */
    function unscoped() {
      return profile().get('mosqueIds', []).size() == 0
             && profile().get('complexIds', []).size() == 0
             && profile().get('mosqueId', '') == ''
             && profile().get('complexId', '') == '';
    }

    /* =====================================================================
       الحصرُ بقيمةٍ غير فارغة (٤٣٢)
       ---------------------------------------------------------------------
       scopeIds() تضمّ mosqueId و complexId من الملفّ ولو كانا فارغين. فسجلٌّ
       complexId فيه فارغٌ (مسجدٌ مستقلّ) كان يطابق القيمةَ الفارغة في ملفّ
       أيّ مديرٍ ليس له مجمّع — فيكتب فيه مديرُ مسجدٍ آخر. فلا يُطابَق إلا
       بقيمةٍ غير فارغة.
       ومديرُ المسجد نطاقُه مسجدُه: سجلٌّ يحمل مسجداً لا يُكتب إلا إن كان
       مسجدَه، ولو اشتركا في المجمّع. وما لا مسجدَ فيه يُحصر بالمجمّع.
       ===================================================================== */
    function sv(d, k) {
      return d.get(k, '') == null ? '' : string(d.get(k, ''));
    }
    function mineMosque(v) {
      return v != '' && (v == sv(profile(), 'mosqueId') || v in profile().get('mosqueIds', []));
    }
    function mineComplex(v) {
      return v != '' && (v == sv(profile(), 'complexId') || v in profile().get('complexIds', []));
    }
    function mqBound(d) { return role() == "mosqueManager" && sv(d, 'mosqueId') != ''; }
    /* مكافئٌ لصيغة ٤٣٢ بنصف التقييم (٤٣٤): مسجدُ السجلّ إن كان لي كفى، وإلّا
       فالمجمّعُ — إلّا لمدير المسجد في سجلٍّ يحمل مسجداً. */
    function inScope(d) {
      return mineMosque(sv(d, 'mosqueId'))
          || (!mqBound(d) && mineComplex(sv(d, 'complexId')));
    }

    /* سجل بلا منشأة لا يُحجب — كثير من السجلات القديمة بلا هذين الحقلين */
    function scopeOk() {
      return unscoped()
        || (d0().get('mosqueId', '') == '' && d0().get('complexId', '') == '')
        || inScope(d0());
    }

    function d0() { return request.resource.data; }

    /* =====================================================================
       والسجلُّ القائمُ نفسُه داخلَ النطاق — لا ما سيصير إليه وحدَه
       ---------------------------------------------------------------------
       scopeOk تفحص السجلَّ بعد التعديل. فكان مديرُ مسجدٍ يعدّل سجلاً يتبع
       مسجداً آخر بأن يكتبه بلا مسجدٍ ولا مجمّع، أو باسم مسجده هو — فيستولي
       عليه. فالتعديلُ والحذفُ يشترطان الطرفين: ما كان، وما سيكون.
       ===================================================================== */
    function oldScopeOk() {
      return unscoped()
        || (resource.data.get('mosqueId', '') == '' && resource.data.get('complexId', '') == '')
        || inScope(resource.data);
    }

    /* حقولٌ لا يكتبها صاحبُ التسجيل الذاتيّ في ملفّه: النطاقُ والصلاحياتُ
       والارتباط. كانت القاعدةُ تفحص الدورَ والتفعيلَ وحدَهما، فيدسّ المسجِّلُ
       نطاقاً وصلاحياتٍ من عنده تبقى له بعد اعتماده — أو لا يكتب نطاقاً
       فيُعامَل بلا حدّ. */
    function privilegedUserKeys() {
      return ['mosqueId', 'complexId', 'mosqueIds', 'complexIds', 'circleId', 'circleIds',
              'perms', 'teacherId', 'studentId', 'studentIds', 'kids', 'admin', 'owner',
              'approvedBy', 'approvedAt'];
    }


    /* حسابٌ داخلَ نطاق المدير: بلا منشأةٍ أصلاً، أو كلُّ منشآته في نطاقه */
    function userScopeOk(d) {
      return (sv(d, 'mosqueId') == '' && sv(d, 'complexId') == ''
              && d.get('mosqueIds', []).size() == 0 && d.get('complexIds', []).size() == 0)
        || (inScope(d)
            && scopeIds().hasAll(d.get('mosqueIds', []))
            && scopeIds().hasAll(d.get('complexIds', [])));
    }

    /* ما يصير إليه الحسابُ بيد مدير المنشأة (٤٣٥): الطالبُ ووليُّ الأمر
       داخلَ نطاقه أو بلا منشأة، وما سواهما (معلّمٌ · مدير مسجد) داخلَ نطاقه
       حتماً — من يُترك بلا نطاقٍ يكتب في كلّ منشأةٍ في النظام. */
    function targetScopeOk(d) {
      return (d.get('role', '') in ['student', 'parent']
              && sv(d, 'mosqueId') == '' && sv(d, 'complexId') == ''
              && d.get('mosqueIds', []).size() == 0 && d.get('complexIds', []).size() == 0)
          || (inScope(d)
              && oneOf(d.get('mosqueIds', []), sv(d, 'mosqueId'))
              && oneOf(d.get('complexIds', []), sv(d, 'complexId')));
    }
    /* قائمةُ المنشآت إمّا فارغة وإمّا منشأةُ الحقل المفرد نفسُها (٤٣٦): صيغةُ
       ٤٣٥ (شرطٌ ثلاثيّ و hasAll) أوقعت محاكيَ Firestore في خطأٍ داخليّ عند
       إنشاء ملفٍّ فيه مسجد، فعلّقت الكتابة. والحسابُ متعدّدُ المنشآت يُنشئه
       مديرُ النظام. */
    function oneOf(l, single) {
      return l.size() == 0 || (l.size() == 1 && string(l[0]) == single);
    }

    /* الملفُّ القائمُ يحمل بريدَ هذا الحساب — انظر «ربط الحساب» في users */
    function linkMatch(d) {
      return request.auth.token.email != null && (
           d.get('loginEmail', '') == request.auth.token.email
        || request.auth.token.email == string(d.get('username', '')) + '@mirath.id'
        || (d.get('email', '') == request.auth.token.email
            && request.auth.token.email_verified == true));
    }
    function linkSrcOk(src) {
      return linkMatch(src)
        && (src.get('uid', '') == '' || src.get('uid', '') == request.auth.uid)
        && request.resource.data.diff(src).affectedKeys().hasOnly(['uid', 'linkedAt', 'linkedFrom']);
    }

    /* ---------------- ملفات المستخدمين ---------------- */
    match /users/{uid} {

      /* قراءة مستند واحد: صاحبه أو الإدارة.
         مطلوبة لـ auth.js و admin/shell.js عند التحقق من الدور. */
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin() || isSupervisor());

      /* ---------------------------------------------------------------
         وهذه جملةٌ قائمةٌ بنفسها، لا تستدعي دالّةً ولا تقرأ مستنداً.
         الجملةُ أعلاه تجمع الشرطَ الذاتيَّ مع isAdmin() و isSupervisor()،
         وكلتاهما تمرُّ بـ role() ثمّ isActive() ثمّ profile() — أي قراءةَ
         مستندٍ وفحصَ حقلٍ فيه. وإن أخفق تقييمُ أيٍّ من ذلك سقطت الجملةُ
         كلُّها ومعها الشرطُ الذاتيُّ البريء، فيُمنع صاحبُ المستند من
         قراءة مستندِه، وتُقفل بوّابةُ الدخول في auth.js و admin/shell.js
         على الطالب والمعلّم — وهو ما جرى فعلاً.

         وقواعدُ Firestore تُقيّم كلَّ allow على حدة ثمّ تجمع نتائجها،
         فإخفاقُ جملةٍ لا يُسقط أختَها. وجودُ هذه الجملة يضمن للطالب
         والمعلّم قراءةَ ملفَّيهما مهما جرى لغيرها.

         ولا تمنح شيئاً زائداً: مستندُ صاحبِها وحدَه، قراءةَ مستندٍ واحد.
         لا list ولا write ولا مستندَ غيرِه.
         --------------------------------------------------------------- */
      allow get: if request.auth != null && request.auth.uid == uid;

      /* سرد المجموعة (استعلامات login.html و admin/users.js و loadAllData):
         للإدارة فقط. login.html يلتقط الرفض ويكمل بالبريد الاصطناعي
         {id}@mirath.id، و loadAllData يعزل الرفض ويكمل بباقي المجموعات. */
      allow list: if isAdmin() || isSupervisor();

      /* =================================================================
         ربطُ الحساب بملفّه القائم عند أوّل دخول (٤٣٢)
         -----------------------------------------------------------------
         الإدارةُ تُنشئ الملفَّ (users/<معرّفٌ ما>) ببريد الدخول أو رقم الهوية
         قبل أن يدخل صاحبُه، فإذا دخل أوّلَ مرّةٍ لم يجد ملفّاً بمعرّف حسابه.
         وكانت بوّابةُ login.html تبحث عن ملفّه بسرد users — وهو للإدارة
         وحدَها — ثمّ تنسخه بدوره وتفعيله، والإنشاءُ الذاتيّ يمنع الاثنين.
         فكان الربطُ يُرفض دائماً ويُقال لصاحبه «راجع الإدارة».
         الآن يقرأ صاحبُ الحساب ما يحمل بريدَه هو وحدَه، وينسخه كما هو حرفاً
         بحرف تحت معرّف حسابه — لا يزيد عليه إلّا uid و linkedAt و linkedFrom.
         فلا يمنح نفسَه دوراً ولا نطاقاً لم تكتبه الإدارة له.
           • loginEmail: بريدُ الدخول الذي كتبته الإدارة.
           • username + @mirath.id: بريدُ النظام لرقم الهوية، ولا يُنشأ
             حسابُه إلّا من الإدارة.
           • email: بريدُ الملفّ، بشرط أن يكون بريدُ الحساب موثَّقاً — وإلّا
             سجّل أحدٌ ببريد موظّفٍ لم يُنشأ حسابه فأخذ ملفّه.
         والملفُّ المربوطُ بحسابٍ آخر (uid مختلف) لا يُربط ثانية.
         ================================================================= */
      allow list: if signedIn() && linkMatch(resource.data);
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.get('linkedFrom', '') is string
                    && request.resource.data.get('linkedFrom', '') != ''
                    && request.resource.data.get('linkedFrom', '') != uid
                    && request.resource.data.get('uid', '') == request.auth.uid
                    && linkSrcOk(get(/databases/$(database)/documents/users/$(request.resource.data.linkedFrom)).data);

      /* إنشاء ذاتي: بدور غير إداري وحساب موقوف بانتظار الاعتماد فقط.
         هذا ما يسدّ ثغرة منح admin التلقائي على مستوى الخادم. */
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role in selfRoles()
                    && request.resource.data.active == false
                    && !request.resource.data.keys().hasAny(privilegedUserKeys());

      /* تعديل ذاتي: حقول العرض فقط — لا role ولا active ولا نطاق. */
      allow update: if signedIn()
                    && request.auth.uid == uid
                    && changed().hasOnly(selfEditable());

      /* اعتمادُ طلبات الانضمام: مديرُ المجمّع ومديرُ المسجد يفعّلان الحساب
         ويرفعان دورَه المطلوب. ثلاثةُ حدودٍ تحرسه:
           • لا يعدّل ملفَّ نفسه   — فلا يرقّي نفسه
           • دورُ الحساب قبل التعديل وبعده كلاهما تحت سقفِ منحه
             — فلا يمسّ مديراً ولا يمنح دوراً أعلى منه
         والحذفُ والإنشاءُ يبقيان لمدير النظام وحده. */
      /* وبياناتُ الدخول (الجوالُ والبريدُ ورقمُ الهوية) لمدير النظام وحده:
         الجوالُ يُستعاد به الحسابُ برسالة SMS، فمن غيّره إلى جواله أخذ الحساب. */
      /* ونطاقُ الحساب (٤٣٢): لا يعدّل مديرُ مسجدٍ حسابَ معلّمٍ في مسجدٍ آخر
         ولا ينقله إلى مسجده. الحسابُ قبل التعديل بلا منشأةٍ (طلبُ انضمامٍ
         لم يُعتمد) أو داخلَ نطاقه، وبعده داخلَ نطاقه أو بلا منشأة. */
      allow update: if isManager()
                    && request.auth.uid != uid
                    && resource.data.role in grantableRoles()
                    && request.resource.data.role in grantableRoles()
                    && !changed().hasAny(['phone', 'email', 'loginEmail', 'username', 'uid'])
                    && (unscoped() || userScopeOk(resource.data))
                    && (unscoped() || targetScopeOk(request.resource.data));

      /* =================================================================
         مديرُ المنشأة يُنشئ حساباً بدورٍ تحت سقفه وداخل نطاقه (٤٣٥)
         -----------------------------------------------------------------
         نموذجُ «إضافة مستخدم» يُتاح لمدير المجمّع والمسجد: يُنشئ حسابَ
         الدخول في Authentication ثمّ يكتب users/{uid} — وكانت الكتابةُ
         للمدير العامّ وحدَه، فيبقى حسابُ دخولٍ يتيمٌ بلا ملفّ. الآن يُكتب
         بدورٍ يملك منحه، ولا لنفسه، ولمعلّمٍ أو مدير مسجدٍ بنطاقٍ داخل نطاقه
         لا بلا نطاق — فالحسابُ بلا نطاقٍ يكتب في كلّ منشأة. */
      allow create: if isManager()
                    && request.auth.uid != uid
                    && request.resource.data.role in grantableRoles()
                    && (unscoped() || targetScopeOk(request.resource.data));

      /* المدير وحده يُنشئ الحسابات ويغيّر الأدوار والحالة ويحذف. */
      allow create, update, delete: if isAdmin();
    }


    /* ---------------- البيانات التشغيلية ---------------- */
    match /{coll}/{docId} {
      allow read: if coll in operational() && ((canRead() && !hiddenFrom(coll)) || donorMay(coll) || kidOwn(coll) || mqOwn(coll) || cxOwn(coll));
      allow create: if coll in operational() && canWrite() && scopeOk();
      allow update: if coll in operational() && canWrite() && scopeOk() && oldScopeOk();
      allow delete: if coll in operational() && canWrite()
                    && (unscoped() || inScope(resource.data))
                    /* الفتراتُ لها قاعدةُ حذفٍ خاصّةٌ أدناه: لا تُحذف إلّا
                       مؤرشفة. وقواعدُ Firestore تُجمع بـ OR، فلو بقيت
                       الفتراتُ هنا لأذِنت هذه القاعدةُ بما تمنعه تلك. */
                    && coll != 'terms';
    }

    /* ---------------- الفترات: لا حذفَ إلّا بعد الأرشفة ---------------- */
    /* «لا تعتمد على إخفاء زر الحذف في الواجهة فقط — يجب فرض شرط الأرشفة
       والصلاحيات على مستوى الخادم. لا تمنح العميل صلاحية تجاوز هذه
       الحماية.» فالمسارُ مفروضٌ هنا: فترةٌ فعّالة ← أرشفة ← حذف.
       والقراءةُ والإنشاءُ والتعديلُ كما لسائر البيانات التشغيلية. */
    match /terms/{docId} {
      allow read:   if canRead();
      allow create: if canWrite() && scopeOk();
      allow update: if canWrite() && scopeOk() && oldScopeOk();
      /* الحصرُ هنا كما في الإنشاء والتعديل سواءً بسواء (scopeOk): سجلُّ
         الفترة بلا مسجدٍ ولا مجمّع، فلو اشتُرط inScope وحدَه لما حذف
         مديرُ منشأةٍ فترةً قطّ — ويُقبل طلبُه في الواجهة ويردّه الخادمُ
         صامتاً. ولا توسعةَ في ذلك: canWrite هو هو. */
      allow delete: if canWrite()
                    && (unscoped()
                        || (resource.data.get('mosqueId', '') == ''
                            && resource.data.get('complexId', '') == '')
                        || inScope(resource.data))
                    && resource.data.archived == true;
    }


    /* ---------------- ما يكتبه المعلّم في عمله اليومي ---------------- */
    /* القاعدة العامة أعلاه تحصر الكتابة في الإدارة، فكان المعلّم يُمنع من
       حفظ الخطط والتسميع وتأشير المصحف واعتماد الحلقة — وهي صميم عمله.
       القواعد تُدمج بـ OR، فهذه البلوكات تضيف المعلّم دون أن تمسّ غيره.

       ⚠ الحصر بالحلقة غير مطبَّق بعد: المعلّم يستطيع تقنياً الكتابة لطالب
       خارج حلقاته. إغلاقه يحتاج ربط circleIds في ملف المستخدم، وهو ضمن
       مرحلة تقييد الصلاحيات القادمة. */

    /* «ضمّ طالب جديد للحلقة» — زرُّ «+» في شاشة الحلقة بتطبيق المعلّم.
       إنشاءٌ فقط: التعديلُ والحذفُ يبقيان للإدارة بالقاعدة العامة أعلاه.
       والمفتاحُ addStudent هو نفسُه في TEACHER_PERMS بـ app.js، وافتراضُه
       مسموحٌ كما في teacherCan — فإن عطّلته الإدارةُ في بطاقة المعلّم
       مُنع هنا كما يُخفى الزرُّ هناك. */
    match /students/{docId} {
      /* الطالبُ ووليُّه: سجلّاتُ أبنائه بأعيانها (٤٤٤) */
      allow read: if (canRead() && !hiddenFrom('students')) || isDonor()
                  || (role() in ['student', 'parent'] && docId in kidIds())
                  || mqOwn('students') || cxOwn('students');
      allow create: if teacherMayAs('addStudent', 'addStudent', true) && scopeOk();
      /* الملفُّ الشخصيّ للطالب ولوليّ أمره: البريدُ والصورةُ وحدَهما (٤٣٠).
         لا نطاقَ ولا ارتباطَ ولا اسمَ — تلك للإدارة. */
      allow update: if ownsStudent(docId)
                    && changed().hasOnly(['email', 'photo']);
      /* نقاطُ التحفيز يمنحها المعلّمُ لطالب نطاقه بصلاحية points (٤٣٥):
         كان سجلُّ النقاط يُكتب ورصيدُ الطالب يُردّ، فلا يتغيّر الرصيد.
         الرصيدُ والمكتسبُ وحدَهما، وكلُّ منحٍ موثَّقٌ في pointsLog. */
      allow update: if isTeacher()
                    && changed().hasOnly(['points', 'balance'])
                    && permOf('points', 'points', true)
                    && oldScopeOk();
    }

    /* =====================================================================
       المتجر — طلبُ الطالب (٤٣٢)
       ---------------------------------------------------------------------
       كان شراءُ الطالب يكتب رصيدَه في سجلّه وكميّةَ الجائزة وسجلَّ النقاط —
       ولا تملك القواعدُ أن تُجيز له كتابةَ رصيده (لزاده). فكان يُرفض كلُّه
       على الخادم ويبقى الخصمُ في جهازه وحده.
       الآن يُنشئ الطالبُ (أو وليُّه) الطلبَ وحدَه: معلَّقاً، لم يُخصم بعد،
       بسعر الجائزة نفسِه كما في سجلّها. والخصمُ وإنقاصُ الكميّة وسجلُّ
       النقاط عند اعتماد الإدارة، والرصيدُ المعروض يطرح المعلَّقَ حتى ذلك.
       ===================================================================== */
    match /storeOrders/{docId} {
      allow create: if ownsSid(sv(request.resource.data, 'studentId'))
                    && request.resource.data.status == 'pending'
                    && request.resource.data.debited == false
                    && request.resource.data.rewardId is string
                    && exists(/databases/$(database)/documents/rewards/$(request.resource.data.rewardId))
                    && string(request.resource.data.cost)
                       == string(get(/databases/$(database)/documents/rewards/$(request.resource.data.rewardId)).data.get('cost', 0));
    }

    /* صورةُ المعلّم في سجلّه — وحدَها (٤٣٠) */
    match /teachers/{docId} {
      allow update: if ownsTeacher(docId)
                    && changed().hasOnly(['photo']);
    }

    /* شروطُ شارات الحلقة — يضعها معلّمُها لحلقته وحدَها، بصلاحية badgeRules
       وافتراضُها مسموحٌ كما في teacherCan. والحقلُ badgeRules وحدَه (٤٣٠). */
    match /circles/{docId} {
      allow update: if ownsCircle(docId)
                    && permOf('badgeRules', 'badgeRules', true)
                    && changed().hasOnly(['badgeRules']);
    }

    /* «طلب اختبار» — يرفعه المعلّم لطالبه فيصل الإدارةَ في أوّل المراحل.
       إنشاءٌ بمرحلة await-sup وحدَها: لا يرفع طلباً معتمداً ولا موثَّقاً،
       ولا يعدّل محفوظاً ولا يحذفه. */
    match /exams/{docId} {
      allow read: if (canRead() && !hiddenFrom('exams')) || kidOwn('exams') || mqOwn('exams') || cxOwn('exams');
      allow create: if teacherMayAs('examRequest', 'examRequest', true)
                    && request.resource.data.stage == 'await-sup'
                    && request.resource.data.studentId is string;
    }

    /* الخططُ: كانت مفتوحةً لكلّ معلّمٍ بلا حصرِ نطاقٍ ولا حصرِ حقول —
       فيعدّل خطةَ أيّ طالبٍ في النظام ويبدّل صاحبَها ومنشأتَها وبرنامجَها.
       الآن: نطاقُه يحصره كسائر الكتابة، وحقولُ الارتباط ممنوعةٌ عليه.
       ولا يُمسّ عملُه: المسارُ والموضعُ والتجميدُ والمقدار كلُّها باقية. */
    match /plans/{docId} {
      allow read: if (canRead() && !hiddenFrom('plans')) || kidOwn('plans') || mqOwn('plans') || cxOwn('plans');
      allow create: if teacherMayAs('plan_edit', 'editPlan', true) && scopeOk();
      allow update: if teacherMayAs('plan_edit', 'editPlan', true) && scopeOk() && oldScopeOk()
                    && (canWrite() || !changed().hasAny(linkFields()));
      /* الحذف للإدارة وحدها: إزالة خطة طالب أخطر من تعديلها،
         والمعلّم يملك التجميد وتعديل المسار وهما يكفيان عمله. */
      allow delete: if canWrite();
    }

    /* ---------------- الواجبات اليومية ----------------
       «أضفتُ واجباً ولا يظهر — والعلامةُ لا تخضرّ».
       assignments مُدرجةٌ في operational() ولا كتلةَ خاصّةَ لها، فتقع تحت
       القاعدة العامّة التي تشترط canWrite() — أي مديراً أو مديرَ منشأة.
       والمعلّمُ ليس واحداً منهما، فكان لا يملك كتابةَ واجبٍ ألبتّة:
       يُضيف فيُردّ، ويُسمّع فلا تُغلق الحالةُ فلا تخضرّ العلامة.
       وهذا عملُ المعلّم اليوميُّ بعينه — و plans و recitations لهما
       كتلتاهما تمنحانه إيّاه، وسقطت assignments وحدَها من الاستثناء.

       تُمنح كما تُمنح الخطة حرفاً بحرف: بصلاحية plan_edit، وداخل نطاقه،
       وحقولُ الارتباط ممنوعةٌ عليه في التعديل — فلا يَنقل واجباً إلى
       طالبٍ آخرَ ولا إلى مسجدٍ آخر. والحذفُ للإدارة وحدها. */
    match /assignments/{docId} {
      allow read: if (canRead() && !hiddenFrom('assignments')) || kidOwn('assignments') || mqOwn('assignments') || cxOwn('assignments');
      allow create: if teacherMayAs('plan_edit', 'editPlan', true) && scopeOk();
      allow update: if teacherMayAs('plan_edit', 'editPlan', true) && scopeOk() && oldScopeOk()
                    && (canWrite() || !changed().hasAny(linkFields()));
      allow delete: if canWrite();
    }

    /* ---------------- عملُ المعلّم اليوميُّ: سجلّاتٌ تُضاف ولا تُعدَّل ----
       ثلاثون مجموعةً في operational() بلا كتلةٍ خاصّة، فكتابتُها تشترط
       canWrite() — أي الإدارة. وفيها ما هو من عمل المعلّم بعينه، فكان
       يُردّ: منحُ النقاط، وسجلُّ الإجراء، والتنبيهُ لوليّ الأمر، والرسالة.

       تُمنح إضافةً فقط (create) — لا تعديلَ ولا حذف. فالسجلُّ يُكتب مرّةً
       ويبقى شاهداً لا يُمحى، ولا يملك المعلّمُ تغييرَ ما مضى. وداخلَ
       نطاقه كسائر كتابته. والمراسلةُ بمفتاحها msg_send كما في
       site_messages، فمن مُنع منها هناك مُنع هنا. */
    match /pointsLog/{docId} {
      allow read: if (canRead() && !hiddenFrom('pointsLog')) || kidOwn('pointsLog') || mqOwn('pointsLog') || cxOwn('pointsLog');
      allow create: if (canWrite() || isTeacher()) && scopeOk();
      allow update, delete: if canWrite();
    }

    match /procLog/{docId} {
      allow read: if canRead() && !hiddenFrom('procLog');
      allow create: if canWrite() || isTeacher();
      allow update, delete: if canWrite();
    }

    match /notifications/{docId} {
      allow read: if canRead();
      allow create: if canWrite() || isTeacher();
      allow update, delete: if canWrite() || isTeacher();
      /* المستلِمُ بعينه يعلّم تنبيهَه مقروءاً — حقلَ read وحدَه (٤٤١). كان
         الطالبُ ووليُّ الأمر لا يملكان ذلك، فيعود التنبيهُ غيرَ مقروء */
      allow update: if isActive()
                    && (resource.data.get('toUid', '') == request.auth.uid
                        || (request.auth.token.get('email', '') != ''
                            && resource.data.get('toEmail', '') == request.auth.token.get('email', '').lower()))
                    && changed().hasOnly(['read'])
                    && request.resource.data.read is bool;
    }

    match /msgOutbox/{docId} {
      allow read: if canRead() && !hiddenFrom('msgOutbox');
      allow create: if teacherMay('msg_send', true);
      allow update, delete: if canWrite();
    }

    match /recitations/{docId} {
      allow read: if (canRead() && !hiddenFrom('recitations')) || kidOwn('recitations') || mqOwn('recitations') || cxOwn('recitations');
      /* الإنشاء عمل يومي، والتعديل على محفوظ صلاحية خاصة */
      /* وداخلَ النطاق: لا يكتب المعلّمُ تسميعاً لطالبٍ في منشأةٍ أخرى ولا يعدّله */
      /* و«تسجيل التسميع» (recite) في بطاقة المعلّم يحرس الإنشاءَ كذلك (٤٣٢):
         كان معلّمٌ أطفأت الإدارةُ تسميعَه يكتب تسميعاً على الخادم. */
      allow create: if teacherMayAs('recite', 'recite', true) && scopeOk();
      allow update: if teacherMayAs('recite_edit', 'recite', true) && scopeOk() && oldScopeOk();
      allow delete: if teacherMayAs('recite_edit', 'recite', true) && oldScopeOk();
    }

    match /mushafMarks/{docId} {
      allow read: if (canRead() && !hiddenFrom('mushafMarks')) || kidOwn('mushafMarks') || mqOwn('mushafMarks') || cxOwn('mushafMarks');
      allow create: if (canWrite() || isTeacher()) && scopeOk();
      /* تأشيرُ اليوم عملٌ عادي، وتعديلُ تأشيرِ يومٍ مضى أو حذفُه صلاحيةٌ خاصة
         (mushaf_past · وفي بطاقة المعلّم editMarks).
         كانت القاعدةُ تقارن تاريخَ السجلّ القديم بالجديد، فيُعدَّل تأشيرٌ
         قديمٌ ما دام تاريخُه لم يتغيّر — وتقرأ request.resource عند الحذف
         وهو فارغٌ فيه، فلا يُزيل المعلّمُ تأشيرَ يومه (٤٣٢).
         الآن «اليوم» بساعة الخادم لا بما يكتبه المتصفّح (anyToday). */
      /* تأشيرُ اليوم يبقى تأشيرَ اليوم: تاريخُه لا يتغيّر، فيكفي فحصُ اليوم مرّة
         واحدة (٤٣٤) — والانتقالُ بتأشيرٍ قديمٍ إلى اليوم تعديلٌ لماضٍ يحتاج الصلاحية. */
      allow update: if canWrite()
                    || (isTeacher()
                        && (permOf('mushaf_past', 'editMarks', true)
                            || (request.resource.data.get('date', '') == resource.data.get('date', '')
                                && anyToday(resource.data.get('date', ''))))
                        && oldScopeOk() && scopeOk());
      allow delete: if canWrite()
                    || (isTeacher()
                        && (permOf('mushaf_past', 'editMarks', true)
                            || anyToday(resource.data.get('date', '')))
                        && oldScopeOk());
    }

    /* اعتماد جلسة الحلقة */
    match /workflow/{docId} {
      allow read: if canRead();
      allow create, update, delete: if canWrite() || isTeacher();
    }

    match /delays/{docId} {
      allow read: if (canRead() && !hiddenFrom('delays')) || kidOwn('delays') || mqOwn('delays') || cxOwn('delays');
      allow create, update: if teacherMay('delay_manage', true);
      allow delete: if teacherMay('delay_manage', true);
    }


    /* ---------------- الحضور اليومي ---------------- */
    /* القاعدة العامة أعلاه تمنح الكتابة للإدارة وحدها، والمعلّم هو من يسجّل
       الحضور فعلياً. القواعد تُدمج بـ OR، فهذا البلوك يضيف المعلّم دون أن
       يمسّ صلاحيات غيره، مع التحقق من شكل السجل حتى لا يُكتب ما هبّ ودبّ.

       ⚠ لا يزال الحصر بالحلقة غير مطبَّق هنا: المعلّم يستطيع تقنياً كتابة
       سجل لطالب خارج حلقاته. إغلاق ذلك يحتاج ربط circleIds في ملف المستخدم
       وهو ضمن مرحلة تقييد الصلاحيات القادمة. */
    match /attendance/{docId} {
      allow read: if (canRead() && !hiddenFrom('attendance')) || kidOwn('attendance') || mqOwn('attendance') || cxOwn('attendance');
      /* التحضير عمل المعلّم اليومي، وتعديل سجل محفوظ يحتاج attend_edit.
         ⚠ «التحضير بعد انتهاء الوقت» (attend_late) يُفحص في المتصفح فقط:
           التاريخ محفوظ بصيغة النظام لا بطابع زمني، فلا تستطيع القاعدة
           مقارنته بوقت الخادم. لإغلاقه على الخادم أضف حقل ts رقمياً
           إلى سجل الحضور ثم قارنه بـ request.time هنا. */
      allow create: if (canWrite() || isTeacher()) && scopeOk()
                    && request.resource.data.status in ['حاضر', 'متأخر', 'مستأذن', 'غائب']
                    && request.resource.data.date is string
                    && request.resource.data.studentId is string;
      allow update: if teacherMayAs('attend_edit', 'attEdit', true) && scopeOk() && oldScopeOk()
                    && request.resource.data.status in ['حاضر', 'متأخر', 'مستأذن', 'غائب']
                    && request.resource.data.date is string
                    && request.resource.data.studentId is string;
      /* سجل خاطئ يجب أن يُحذف لا أن يُترك — بنفس صلاحية التعديل */
      allow delete: if teacherMayAs('attend_edit', 'attEdit', true) && oldScopeOk();
    }


    /* ---------------- إعدادات النظام ---------------- */
    /* مستندا general و exams — يقرأهما الجميع، ويكتبهما المدير وحده. */
    match /settings/{docId} {
      allow read:  if canRead() || isDonor();
      allow write: if isAdmin();

      /* «إدارة الصلاحيات» — فُتحت لكلّ معلّمٍ بطلبٍ صريح من الإدارة.
         ومحصورةٌ في مستندٍ واحدٍ اسمُه teacherPerms لا يحمل إلا مفاتيحَ
         الصلاحيات: فلا يصل المعلّمُ إلى بقيّة الإعدادات، ولا يستطيع أن
         يدسّ معها حقلاً آخر. والقواعدُ تُدمج بـ OR، فهذا البلوك يضيف
         ولا يوسّع ما سواه.

         ⚠ أثرُها المقصود: المعلّمُ يستطيع رفعَ قيدٍ وُضع عليه — وعلى
         زملائه، فالمستندُ واحدٌ لكلّ المعلّمين. */
      allow write: if docId == "teacherPerms"
                   && (isTeacher() || isManager())
                   && request.resource.data.keys().hasOnly(['id', 'teacherPerms']);

      /* مكتبةُ الشارات — صارت بيدِ مديرِ المسجد ومديرِ المجمّع والمشرف
         بطلبٍ صريح، وخرجت من يد مدير النظام ومالكه. ومحصورةٌ في مستندٍ
         واحدٍ لا يحمل إلا مفتاحَها، على منوال teacherPerms أعلاه: فلا
         يبلغ مديرُ المنشأة بقيّةَ الإعدادات ولا يدسّ معها حقلاً آخر.
         و _o يُضيفه persistSet إلى كلّ مستند، فلا بدّ من قبوله وإلّا
         رُدّت الكتابةُ كلُّها. */
      allow write: if docId == "badges"
                   && isManager()
                   && request.resource.data.keys().hasOnly(['id', 'badgeLib', '_o']);
    }


    /* ---------------- الرسائل داخل الموقع ---------------- */
    match /site_messages/{msgId} {

      /* بريدُ الجلسة بأحرفٍ صغيرة — حسابٌ بلا بريدٍ لا يطابق شيئاً */
      function myMail() { return request.auth.token.email.lower(); }

      /* المرسَل إليه يقرأ رسائله، والمرسِل ما أرسله، وطرفا المحادثة رسائلَها
         (threadId = البريدان مرتَّبَين بينهما «|» كما يبنيه chat.js)، والإدارة
         تقرأ الكل. والاستعلاماتُ الثلاثة في التطبيق مقيَّدةٌ بأحد هذه الحقول:
         where("toEmail"/"fromEmail"/"threadId", "==", …) فتمرّ. (٤٣٢) */
      allow read: if isActive() && (
                       resource.data.get('toEmail', '') == myMail()
                    || resource.data.get('fromEmail', '') == myMail()
                    || myMail() in string(resource.data.get('threadId', '')).split('[|]')
                    || isAdmin() || isSupervisor()
                  );

      /* الإرسال من الإدارة والمعلمين، ومن الطالب ووليّ الأمر باسمهما هما
         (fromEmail بريدُ الجلسة) — ولا يجوز انتحال حالة القراءة. */
      allow create: if (isAdmin() || isSupervisor() || teacherMay('msg_send', true)
                        || ((role() == "student" || role() == "parent")
                            && request.resource.data.get('fromEmail', '') == myMail()))
                    && request.resource.data.toEmail is string
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 4000
                    && request.resource.data.read == false;

      /* المستلِم لا يملك إلا تعليم الرسالة كمقروءة. */
      allow update: if isActive()
                    && resource.data.toEmail == myMail()
                    && changed().hasOnly(['read']);

      /* وما كانت القاعدةُ العامّة تمنحه للإدارة يبقى لها */
      allow update, delete: if canWrite();
    }


    /* ---------------- سجل العمليات ---------------- */
    /* إلحاق فقط: يكتبه كل حساب فعّال باسمه هو، ويقرؤه المدير والمشرف،
       ولا يُعدَّل ولا يُحذف أبداً — ولا حتى من المدير. هذا شرط أن يكون
       السجل دليلاً: سجلّ يمكن تعديله لا يثبت شيئاً. */
    match /auditLog/{entryId} {

      /* المديرُ والمالكُ وحدَهما (٤٥٢): صفحةُ السجلّ لا يفتحها غيرُهما (SYSTEM_ONLY
         في app.js)، وكان مديرُ المجمّع ومديرُ المسجد يقرآنه كاملاً — سجلَّ كلِّ
         حفظٍ في كلّ المنشآت. والكتابةُ (الإلحاقُ) باقيةٌ لكلّ حسابٍ فعّال. */
      allow read: if isAdmin();

      /* وبصيغة app.js (٤٣٦): byUid و act — كانت القاعدةُ تشترط uid و action
         وحدَهما، وهما صيغةُ governance.js غير المحمَّل، فيُردّ كلُّ قيدٍ يكتبه
         التطبيق ولا يُحفظ في السجلّ شيء. الشرطُ هو هو: باسم كاتبه وبفعلٍ معروف. */
      allow create: if isActive()
                    && ((request.resource.data.get('uid', '') == request.auth.uid
                         && request.resource.data.get('action', '') in ['create', 'update', 'delete'])
                        || (request.resource.data.get('byUid', '') == request.auth.uid
                            && request.resource.data.get('act', '') in ['create', 'update', 'delete']))
                    && request.resource.data.coll is string
                    && request.resource.data.ts is number;

      allow update, delete: if false;
    }


    /* ---------------- فهرسُ المساجد العلنيّ ---------------- */
    /* =====================================================================
       «عند تسجيل الطالب لأوّل مرّة تكون خانةٌ يتبع لأيّ مسجد… يرى كلّ
       المساجد ويختار منهم».

       وصفحةُ التسجيل يفتحها من لا حسابَ له، و canRead() تشترط حساباً
       فعّالاً — فلا سبيل إلى عرض أسماء المساجد منها.

       ولم تُفتح مجموعةُ mosques للعامّة: مستندُ المسجد يحمل رابطَ مقرأته
       ورقمَ مشرفه، وفتحُها يُطلع عليها كلَّ من في الإنترنت. فأُفرد لها
       مستندٌ واحدٌ لا يحمل إلّا **المعرّف والاسم** — قدرَ ما يحتاجه
       المسجّل ولا حرفَ زيادة.

       وهو مستندٌ واحدٌ بعينه: get وحدَها، بلا list، فلا تُسرَد المجموعة.
       والكتابةُ للإدارة ومديري المنشآت — وهم من يُنشئ المساجد ويعدّلها.
       ===================================================================== */
    match /publicIndex/{docId} {
      allow get:   if docId == 'mosques';
      allow list:  if false;
      allow write: if isAdmin() || isManager();
    }


    /* ---------------- المنع الافتراضي ---------------- */
    /* أي مسار لم يُذكر أعلاه ممنوع تماماً. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}